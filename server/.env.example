# Copie ce fichier en server/.env puis remplis-le. Le fichier .env n'est JAMAIS commité.

# Clé API Anthropic (console.anthropic.com → API Keys). Jamais dans l'app, jamais dans git.
ANTHROPIC_API_KEY=

# Modèles utilisés
MODEL_RESPOND=claude-opus-5-5     # rédaction / modification du devis (qualité)
MODEL_EXTRACT=claude-sonnet-5-5   # lecture des captures d'écran (coût / vitesse)
# Niveau de réflexion (low | medium | high). Plus haut = meilleur mais plus lent et plus cher.
EFFORT_RESPOND=medium
EFFORT_EXTRACT=low
# 1 = si un modèle refuse une demande par erreur, l'API la relance sur un autre modèle (recommandé).
LLM_FALLBACK=1

# Jeton partagé avec l'app iPhone. Génère-le avec :
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
APP_TOKEN=

# 1 = réponses préparées à l'avance, aucun appel à l'API (démo, tests, développement)
MOCK_LLM=0

# Chemin de LibreOffice si non trouvé automatiquement
# (macOS : /Applications/LibreOffice.app/Contents/MacOS/soffice)
SOFFICE_BIN=

# Garde-fous
DAILY_CALL_CAP=300     # plafond d'appels à l'IA par jour (garde-fou de coût)
MAX_IMAGES=6
MAX_BODY_MB=20
